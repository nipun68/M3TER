# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb://localhost:27017/m3ter_db

# Security & Authentication (Preserved from Express.js/JWT.js)
JWT_SECRET_KEY=PASSKEY

# Payment Provider Configuration (Stripe)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Engine Worker Tuning
METER_BATCH_SIZE=100
METER_FLUSH_INTERVAL=5.0
ENTITLEMENT_CACHE_TTL=30.0
LIFECYCLE_INTERVAL=60.0
